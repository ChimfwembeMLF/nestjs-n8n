{
  "name": "@chimfwembe/nestjs-n8n",
  "version": "1.0.1",
  "description": "A fluent NestJS client for n8n automation workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nestjs",
    "n8n",
    "automation",
    "workflow",
    "webhook",
    "api-client"
  ],
  "author": "Chimfwembe Kangwa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChimfwembeMLF/nestjs-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/ChimfwembeMLF/nestjs-n8n/issues"
  },
  "homepage": "https://github.com/ChimfwembeMLF/nestjs-n8n#readme",
  "peerDependencies": {
    "@nestjs/axios": "^3.0.0 || ^4.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/testing": "^11.1.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "axios": "^1.7.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "class-validator": "^0.14.2"
  }
}
